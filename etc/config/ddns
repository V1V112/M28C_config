config service 'm28c_ipv6'
	option enabled '1'
	option service_name 'cloudflare.com-v4'
	option lookup_host 'm28c.sharedrive.top'
	option domain 'm28c@sharedrive.top'
	option username 'Bearer'
	option password '填写 CloudFlare API Token令牌'
	option use_ipv6 '1'
	option interface 'Modem_v6'
	option ip_source 'network'
	option ip_network 'Modem_v6'
	option use_api_check '1'
	option check_interval '10'
	option check_unit 'minutes'
	option force_interval '72'
	option force_unit 'hours'
	option param_opt 'zone_id=56e263fde352d68367ebfa83446ce3dd dns_record_id=36ab38fc1518aad7fa648ba7ec036e2b'